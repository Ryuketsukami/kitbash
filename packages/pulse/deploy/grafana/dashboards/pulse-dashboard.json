{
  "title": "Pulse",
  "uid": "kitbash-pulse",
  "tags": ["pulse", "kitbash"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Sessions",
      "datasource": { "type": "postgres", "uid": "pulse-pg" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT session_id) AS \"sessions\" FROM pulse_events WHERE $__timeFilter(ts)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Users",
      "datasource": { "type": "postgres", "uid": "pulse-pg" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT coalesce(user_id, anon_id)) AS \"users\" FROM pulse_events WHERE $__timeFilter(ts)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Revenue",
      "datasource": { "type": "postgres", "uid": "pulse-pg" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum((props->>'amount')::float8), 0) AS \"revenue\" FROM pulse_events WHERE $__timeFilter(ts) AND event IN ('purchase','subscription_started','subscription_renewed') AND jsonb_typeof(props->'amount') = 'number'"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "5xx rate",
      "datasource": { "type": "postgres", "uid": "pulse-pg" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(avg(CASE WHEN status >= 500 THEN 100.0 ELSE 0.0 END), 0) AS \"5xx %\" FROM pulse_requests WHERE $__timeFilter(ts)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throughput",
      "datasource": { "type": "postgres", "uid": "pulse-pg" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 8 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), count(*) AS \"events\" FROM pulse_events WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), count(*) AS \"api requests\" FROM pulse_requests WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API latency",
      "datasource": { "type": "postgres", "uid": "pulse-pg" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "fillOpacity": 0 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), percentile_cont(0.5) WITHIN GROUP (ORDER BY dur_ms) AS \"p50\", percentile_cont(0.95) WITHIN GROUP (ORDER BY dur_ms) AS \"p95\", percentile_cont(0.99) WITHIN GROUP (ORDER BY dur_ms) AS \"p99\" FROM pulse_requests WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Errors",
      "datasource": { "type": "postgres", "uid": "pulse-pg" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 8 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), count(*) AS \"client errors\" FROM pulse_events WHERE $__timeFilter(ts) AND event = 'error' GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), count(*) AS \"5xx\" FROM pulse_requests WHERE $__timeFilter(ts) AND status >= 500 GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Revenue",
      "datasource": { "type": "postgres", "uid": "pulse-pg" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 12 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), coalesce(sum((props->>'amount')::float8), 0) AS \"revenue\" FROM pulse_events WHERE $__timeFilter(ts) AND event IN ('purchase','subscription_started','subscription_renewed') AND jsonb_typeof(props->'amount') = 'number' GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Top events",
      "datasource": { "type": "postgres", "uid": "pulse-pg" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT event, count(*) AS count, count(DISTINCT coalesce(user_id, anon_id)) AS users FROM pulse_events WHERE $__timeFilter(ts) GROUP BY event ORDER BY count DESC LIMIT 15"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Top API routes",
      "datasource": { "type": "postgres", "uid": "pulse-pg" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT route, count(*) AS requests, round((percentile_cont(0.95) WITHIN GROUP (ORDER BY dur_ms))::numeric, 1) AS p95_ms, count(*) FILTER (WHERE status >= 500) AS \"5xx\" FROM pulse_requests WHERE $__timeFilter(ts) GROUP BY route ORDER BY requests DESC LIMIT 15"
        }
      ]
    }
  ]
}
