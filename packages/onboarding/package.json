{
  "name": "@kitbash/onboarding",
  "version": "0.1.0",
  "description": "Spotlight onboarding tours for React — dim the screen, highlight one element at a time, guide with a card.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
